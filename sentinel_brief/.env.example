# Sentinel Brief — local Splunk connection (copy to .env and fill in).
# .env is gitignored; never commit real credentials.

# Splunk management API (NOT the web port 8000). Default mgmt port is 8089.
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=changeme

# Vertex / Gemini (project resolved from ADC if unset)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# MCP Server (bonus lane — fill after installing the MCP Server App + generating a token)
SPLUNK_MCP_URL=
SPLUNK_MCP_TOKEN=
